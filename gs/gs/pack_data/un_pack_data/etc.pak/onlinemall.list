#FORM2

#[124132]:  括号中为条形码
#for_sale:    是否出售(1出售,0不出售)
#show_pos:    显示位置
#coin:        元宝价格
#coin_type:   1表示只有金元宝都可以买，3表示金银都能买，2表示只有银元宝能买
#recommend:   是否为推荐道具
#name:        必须为物品的导入名称（不能是显示名称）

#可选配置——配置商城道具描述
#mall_desc : "\n#W#l#Yxxx#Wxxxx\n#W#l#Yxxx#Wxxxx\n#W#l#Yxxx#Wxxxx\n#W#l#Yxxx#wxxxx\n#W#l#Yxxx#Wxxxx"
#xxx分别为："使用效果："、"适用等级："、"使用方法："、"配合玩法："、"最佳组合："
#xxxx为：各自对应的描述

##################道具类型对应表####################
[道具类型对应表]
推荐专区 : 1
练功道具 : 2
功能道具 : 3
装备打造 : 4
宠物坐骑 : 5
时装 : 6
铭牌 : 7

