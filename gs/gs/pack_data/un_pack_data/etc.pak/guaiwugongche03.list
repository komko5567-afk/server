#FORM2
#怪物攻城配置文件（公测区）
#

[活动时间]
time_list$ : ({ "2024-07-01-21:00:00", "EVERY_HOUR(1)", "EVERY_DAY(1)", "2028-05-30-23:59:59" })

[活动相关]
default_duration : 3600

#刷新怪物的间隔
#活动中怪物刷新广播
msg_fill_monster: "#G玄秘宝箱#n对#R中洲大陆#n发动了第$ROUND轮的攻击，请侠义之士迅速赶到$ROOM参与击杀吧！#n。"
time_fill_monster: 600
interval_fill_monster: 600
duration_fill_monster: 3500

#活动开始前广播
msg_prev_start: "#G玄秘福利宝箱#n活动将于#R$ST#n开放。"
time_prev_start: 1800
interval_prev_start: 180

#活动开始时广播
msg_start: "大批的#G玄秘宝箱#n对#R中洲大陆#n发动了攻击，请侠义之士迅速赶到$ROOM击杀妖魔。"

#活动中广播
msg_in_festival: "#G玄秘宝箱#n对#R中洲大陆#n发动了攻击，请侠义之士迅速赶到$ROOM击杀妖魔。"
interval_in_festival: 1200
time_in_festival: 600

#活动刷新怪物停止时的广播
msg_stop_fill: "#G玄秘宝箱#n已有撤退之意，大家要加油了！#n"
interval_stop_fill: 600

#活动停止时广播
msg_stop: "#G玄秘宝箱#n已经撤退了！感谢勇士们共同守护中洲大陆。#n"

#活动正常停止时广播
msg_normal_stop: "#G玄秘宝箱#n已经全部被消灭了！感谢勇士们共同守护中洲大陆。#n"

#强制终止战斗的提示
msg_retreat: "玄秘宝箱#n已经撤退了！"


#怪物生成区域
rooms$: 富甲钱庄



[富甲钱庄]
monster_list$: 富甲钱庄BOSS1

[富甲钱庄BOSS1]
num : 20
name$: 玄秘宝箱
type: "boss_monster"
