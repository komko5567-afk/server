#FORM2

# start_type活动的开启方式，
# 1表示以setting1这种有规律的方式配置
# 2表示以setting2做随意的时间的配置
# setting1-start_time开启时间以超过整点的秒数计
# setting1-duration_time活动的持续时间
# setting1-interval_time两次活动开启的间隔时间
# setting2-maf_time本次的开启时间和持续时间

[type]
setting_type : 1

[setting1]
start_time    : 1800
duration_time : 3600
interval_time : 3600

[setting2]
maf_time$ : ({ "2009-04-03-12:30:00", 600 })
maf_time$ : ({ "2009-04-03-18:30:00", 600 })
maf_time$ : ({ "2009-04-25-20:30:00", 600 })

[monster]
icon : ({ "6249", "6245", "6244" })

