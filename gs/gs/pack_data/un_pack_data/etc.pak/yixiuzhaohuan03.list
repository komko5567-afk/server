#FORM2

#dujiachoujianghuodong.list
#created by huangw2 Aug/25/2008
#独家抽奖游戏活动
#自己兑换自己想要的东西，我只加了个神兽估计都懂

[task_time]
start_time : "2008-11-13-12:00:00"
maf_time$ :  ({ "2008-11-13-12:00:00", "2023-08-23-12:00:00" })


[兑换奖励]
rate : 1
name$ : 兑换奖励
log_to_db:  100
free_pet:   ({ 1, "你携带的宠物数量已到最大，无法领取奖励。" })
bonus$:  ({ 0, 0, 100, "宠物", 1, 1, "天竺公主", "姑射元君", "大力神猪", "夫诸", "笛舞", "赤天", "降魔", "混沌", "震魃", "齐天大圣", "净坛使者", "罴九" })
bonus_times : -1

[净坛使者]
