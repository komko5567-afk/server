#FORM2

[活动时间]
time_list$ : ({ "2024-05-30-00:00:00", "EVERY_DAY(999)", "EVERY_WEEK(0)", "2027-02-23-00:00:00" })

[broadcast_setting]
broadcast_list : ({ "during_task", "end_task" })

[during_task]
broadcast_start : "start_time(0)"
interval        : 3600
broadcast_end   : "end_time(-1)"
message         : "#R【镇守】云霄镇守#n活动开始啦，大家快前往#P云霄镇守|云霄宫(261,199)#P处挑战，挑战成功可获得丰厚的奖励哦！"
channel         : "CHANNEL_SYSTEM | CHANNEL_NO_BROADCAST"

[end_task]
broadcast_start : "end_time(0)"
interval        : 0
broadcast_end   : "end_time(1)"
message         : "#R【镇守】云霄镇守#n活动圆满结束啦，感谢大家的参与。"
channel         : "CHANNEL_SYSTEM | CHANNEL_NO_BROADCAST"
